---
import '../styles/global.css';
import {
  profile, links, about, education, experience, projectCategories, projects,
  skillGroups, certifications, interests, contact, lastUpdated,
} from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const asset = (p: string) => (/^https?:\/\//.test(p) ? p : base + p.replace(/^\//, ''));

const nav = [
  ['about', 'About'], ['education', 'Education'], ['experience', 'Experience'], ['projects', 'Projects'], ['contact', 'Contact'],
];
const usedTags = new Set([...experience, ...projects].flatMap((i) => i.tags));

// Search index, shipped to the browser as JSON.
const searchIndex = [
  ...nav.concat([['skills', 'Skills'], ['beyond', 'Beyond work']]).map(([id, label]) => ({ label, kind: 'Section', href: '#' + id })),
  ...experience.map((e) => ({ label: e.title, kind: 'Experience', href: '#experience', open: e.id })),
  ...projects.map((p) => ({ label: p.title, kind: 'Project', href: '#projects', open: p.id })),
];

const title = `${profile.name} | Business & Data Analyst`;
const description = profile.intro;
const chevron = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
const icons: Record<string, string> = {
  film: '<rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3"/>',
  code: '<path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12"/>',
  plus: '<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>',
};
---
<!doctype html>
<html lang="en" class="theme-light view-overview">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <script is:inline>
    (function () {
      var d = document.documentElement, t = null, v = null;
      try { t = localStorage.getItem('theme'); v = localStorage.getItem('view'); } catch (e) {}
      if (!t) t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      d.classList.remove('theme-light', 'view-overview');
      d.classList.add('theme-' + t, 'view-' + (v === 'index' ? 'index' : 'overview'), 'js');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,650&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="hdr">
    <div class="wrap nav">
      <a href="#top" class="brand"><span class="brand-mark" aria-hidden="true">{profile.initials}</span>{profile.name}</a>
      <div class="util">
        <button type="button" class="search-btn" id="search-open" aria-label="Search the site" aria-keyshortcuts="Meta+K Control+K /">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <span class="hide-md">Search</span>
          <span class="kbd hide-md" id="kbd-hint">⌘K</span>
        </button>
        <div class="seg" role="group" aria-label="Layout">
          <button type="button" data-view="overview" aria-pressed="true">Overview</button>
          <button type="button" data-view="index" aria-pressed="false">Index</button>
        </div>
        <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        </button>
        <a href={asset(links.resume)} class="cta cta-primary lift" target="_blank" rel="noopener">Resume</a>
      </div>
      <nav aria-label="Sections" class="nav-links">
        {nav.map(([id, label]) => <a href={'#' + id} class="nav-link" data-spy={id}>{label}</a>)}
      </nav>
    </div>
    <div class="progress" aria-hidden="true"></div>
  </header>

  <main id="main">
    <section id="top" class="wrap hero">
      <div class="hero-main">
        <p class="live"><span></span>{profile.status}</p>
        <h1 class="hero-title">{profile.headline}</h1>
        <p class="hero-intro">{profile.intro}</p>
        <div class="hero-ctas">
          <a href={asset(links.resume)} class="cta cta-primary lift" target="_blank" rel="noopener">View resume</a>
          <a href="#projects" class="cta cta-quiet lift">See projects</a>
        </div>
      </div>
      <aside class="glance" aria-label="At a glance">
        <div class="glance-photo">
          {profile.photo
            ? <img src={asset(profile.photo)} alt={`Photo of ${profile.name}`} />
            : <span aria-hidden="true">{profile.initials}</span>}
        </div>
        <dl class="readout num">
          {profile.glance.map((g) => <div class={g.wide ? 'wide' : undefined}><dt>{g.label}</dt><dd>{g.value}</dd></div>)}
        </dl>
      </aside>
    </section>

    <section id="about" class="section">
      <div class="wrap sec">
        <div class="sec-head"><h2>About</h2></div>
        <div class="sec-body about">{about.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section id="education" class="section">
      <div class="wrap sec">
        <div class="sec-head"><h2>Education</h2></div>
        <div class="sec-body edu-grid">
          {education.map((e) => (
            <article class="card">
              <h3>{e.school}</h3>
              <p class="line">{e.degree}</p>
              <p class="line num muted">{e.meta}</p>
              {e.note && <p class="note">{e.note}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="section">
      <div class="wrap sec">
        <div class="sec-head"><h2>Experience</h2></div>
        <div class="sec-body">
          <ol class="timeline only-overview">
            {experience.map((e) => (
              <li class="item" data-item={e.id} data-tags={e.tags.join('|')}>
                <span aria-hidden="true" class={'dot ' + (e.dates?.includes('Present') ? 'dot-now' : 'dot-past')}></span>
                <p class="date num">{e.dates}</p>
                <h3 id={'h-' + e.id}>{e.title}</h3>
                <p class="muted">{e.org}</p>
                <p class="summary">{e.summary}</p>
                <div class="item-foot">
                  <button type="button" class="toggle" aria-expanded="false" aria-controls={'p-' + e.id} data-open={e.id}>Show details<Fragment set:html={chevron} /></button>
                  <span class="spacer"></span>
                  {e.tags.map((t) => <button type="button" class="chip" aria-pressed="false" data-tag={t}>{t}</button>)}
                </div>
                <div id={'p-' + e.id} class="panel" role="region" aria-labelledby={'h-' + e.id} hidden>
                  <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
                </div>
              </li>
            ))}
          </ol>
          <div class="only-index">
            {experience.map((e) => (
              <div class="index-row item" data-item={e.id} data-tags={e.tags.join('|')}>
                <p class="date num">{e.dates}</p>
                <div>
                  <h3 id={'hi-' + e.id}>{e.title}<span class="org">, {e.org}</span></h3>
                  <div id={'pi-' + e.id} class="panel" role="region" aria-labelledby={'hi-' + e.id} hidden>
                    <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
                  </div>
                </div>
                <button type="button" class="toggle" aria-expanded="false" aria-controls={'pi-' + e.id} data-open={e.id}>Show details<Fragment set:html={chevron} /></button>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="section tinted">
      <div class="wrap sec">
        <div class="sec-head">
          <div class="proj-head">
            <h2>Projects</h2>
            <div class="cats" role="group" aria-label="Filter projects by area">
              {['All', ...projectCategories].map((c, i) => <button type="button" class="cat" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={c}>{c}</button>)}
            </div>
          </div>
        </div>
        <div class="sec-body">
          <div class="proj-grid only-overview" data-n={projects.length}>
            {projects.map((p, i) => (
              <article class={'proj item' + (i === 0 ? ' is-feature' : '')} data-item={p.id} data-tags={p.tags.join('|')} data-cats={(p.cats ?? []).join('|')}>
                <div class="proj-media" aria-hidden={p.image ? undefined : 'true'}>
                  {p.image ? <img src={asset(p.image)} alt={`${p.title} screenshot`} loading="lazy" /> : <span>{p.title}</span>}
                </div>
                <div class="proj-body">
                  <p class="kind">{p.kind}</p>
                  <h3 id={'h-' + p.id}>{p.title}</h3>
                  <p class="summary">{p.summary}</p>
                  <div class="chips">{p.tags.map((t) => <button type="button" class="chip" aria-pressed="false" data-tag={t}>{t}</button>)}</div>
                  <div class="actions">
                    <button type="button" class="toggle" aria-expanded="false" aria-controls={'p-' + p.id} data-open={p.id}>Show details<Fragment set:html={chevron} /></button>
                    {p.link && <a href={p.link} target="_blank" rel="noopener">Code on GitHub</a>}
                  </div>
                  <div id={'p-' + p.id} class="panel" role="region" aria-labelledby={'h-' + p.id} hidden>
                    <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="only-index">
            {projects.map((p) => (
              <div class="index-row item" data-item={p.id} data-tags={p.tags.join('|')} data-cats={(p.cats ?? []).join('|')}>
                <p class="date">{p.kind}</p>
                <div>
                  <h3 id={'hi-' + p.id}>{p.title}</h3>
                  <div id={'pi-' + p.id} class="panel" role="region" aria-labelledby={'hi-' + p.id} hidden>
                    <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>
                  </div>
                </div>
                <button type="button" class="toggle" aria-expanded="false" aria-controls={'pi-' + p.id} data-open={p.id}>Show details<Fragment set:html={chevron} /></button>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="wrap sec">
        <div class="sec-head"><h2>Skills</h2></div>
        <div class="sec-body">
          <p class="skills-intro">Pick a skill to highlight the work that uses it.</p>
          <div class="skill-list">
            {skillGroups.map((g) => (
              <div class="skill-row">
                <span class="skill-name">{g.name}</span>
                <div class="skill-chips">
                  {g.skills.map((s) => usedTags.has(s)
                    ? <button type="button" class="chip" aria-pressed="false" data-tag={s}>{s}</button>
                    : <span class="chip">{s}</span>)}
                </div>
              </div>
            ))}
          </div>
          <p class="tag-status" role="status" hidden><span id="tag-text"></span><button type="button" class="toggle" id="tag-clear">Clear filter</button></p>
          {certifications.length > 0 && <p class="certs">Certification: {certifications.join('; ')}</p>}
        </div>
      </div>
    </section>

    <section id="beyond" class="section">
      <div class="wrap sec">
        <div class="sec-head"><h2>Beyond work</h2></div>
        <div class="sec-body beyond">
          {interests.map((it) => (
            <div>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon] ?? icons.plus}></svg>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section tinted">
      <div class="wrap contact-wrap">
        <div class="contact-card">
          <div class="contact-copy">
            <h2>{contact.heading}</h2>
            <p class="lede">{contact.text}</p>
            <div class="contact-links">
              <a href={asset(links.resume)} class="cta cta-primary cta-sm lift" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11v6M9.5 14.5 12 17l2.5-2.5"/></svg>Resume</a>
              <a href={links.linkedin} class="cta cta-quiet cta-sm lift" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg>LinkedIn</a>
              <a href={links.github} class="cta cta-quiet cta-sm lift" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>GitHub</a>
              <a href={'mailto:' + links.email} class="cta cta-quiet cta-sm lift"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>Email</a>
            </div>
          </div>
          <form class="contact-form" id="contact-form" action={links.formEndpoint || 'mailto:' + links.email} method="POST" data-endpoint={links.formEndpoint} data-email={links.email}>
            <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field full"><label for="f-msg">Message</label><textarea id="f-msg" name="message" rows="4" required></textarea></div>
            <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="full" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
              <button type="submit" class="cta cta-primary lift">Send message</button>
              <p class="form-status" id="form-status" role="status"></p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap footer">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>Last updated {lastUpdated}</span>
  </footer>

  <dialog class="search" id="search" aria-label="Search">
    <label for="q" class="sr-only">Search sections, roles and projects</label>
    <input id="q" type="search" placeholder="Search sections, roles and projects" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="results" />
    <ul class="results" id="results" role="listbox"></ul>
    <p class="empty" id="search-empty" hidden></p>
    <div class="search-foot"><button type="button" class="toggle" id="search-close">Close</button></div>
  </dialog>

  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)}></script>
  <script src="../scripts/main.ts"></script>
</body>
</html>
